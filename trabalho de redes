
#include <stdio.h>

int main() {
    int estado[10];
    int N, ativos = 0, inativos = 0;
    int i;
    float percentual;

    printf("Digite a quantidade de dispositivos (1 a 10): ");
    if (scanf("%d", &N) != 1) {
        printf("Entrada invalida.\n");
        return 1;
    }

    while (N < 1 || N > 10) {
        printf("Digite um numero entre 1 e 10: ");
        scanf("%d", &N);
    }

    for (i = 0; i < N; i++) {
        printf("Dispositivo %d (1 ativo, 0 inativo): ", i + 1);
        scanf("%d", &estado[i]);

        while (estado[i] != 0 && estado[i] != 1) {
            printf("Digite somente 1 ou 0: ");
            scanf("%d", &estado[i]);
        }

        if (estado[i] == 1) {
            ativos++;
        } else {
            inativos++;
        }
    }

    percentual = ativos * 100.0f / N;

    printf("\n--- RADAR DA REDE ---\n");
    printf("Ativos: %d\n", ativos);
    printf("Inativos: %d\n", inativos);
    printf("Disponibilidade: %.1f%%\n", percentual);

    if (inativos >= 2) {
        printf("ALERTA: 2 ou mais dispositivos inativos!\n");
    } else {
        printf("Situacao normal.\n");
    }

    return 0;
}

